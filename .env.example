# raw-print configuration — copy this file to `.env` and edit.
#
#   cp .env.example .env
#
# (In the packaged Windows tray app you don't edit this file — instead use the
#  tray menu → "Edit configuration…", which opens %APPDATA%\raw-print\config.env
#  with these same keys.)

# Port the local agent listens on. Your browser calls http://localhost:<PORT>.
PORT=9100

# Browser origins allowed to call the agent (CORS). Use * for any, or a
# comma-separated list of exact origins for a locked-down setup.
ALLOWED_ORIGIN=*
# ALLOWED_ORIGIN=https://app.yourshop.com,http://localhost:3000

# NOTE: printers are NOT configured here. The agent auto-detects installed
# printers (GET /printers). Your app chooses which file goes to which printer
# per request via the "jobs" field — see README.md.
