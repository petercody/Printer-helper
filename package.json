{
  "name": "printer-connect",
  "version": "1.0.0",
  "description": "Local print agent: routes any number of files to named printers, no dialog. Runs as a Windows tray app.",
  "type": "module",
  "main": "dist/electron/main.js",
  "author": "Printer Connect",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "printers": "tsx src/list-printers.ts",
    "app": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "pack": "npm run build && electron-builder --win --dir",
    "pack:mac": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "pdf-to-printer": "^5.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "com.printerconnect.agent",
    "productName": "Printer Connect",
    "asar": true,
    "asarUnpack": [
      "node_modules/pdf-to-printer/**"
    ],
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "title": "Printer Connect"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Printer Connect"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
